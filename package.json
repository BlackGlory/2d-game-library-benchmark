{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "deduplicate": "yarn-deduplicate",
    "lint": "eslint --quiet src",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release": "standard-version",
    "deploy": "./deploy.sh"
  },
  "husky": {
    "hooks": {
      "pre-commit": "run-s lint build test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "@blackglory/prelude": "^0.5.0",
    "@blackglory/structures": "^0.15.4",
    "@blackglory/wait-for": "^0.8.5",
    "@dimforge/rapier2d": "^0.21.0",
    "@headlessui/react": "^2.2.10",
    "@thi.ng/ecs": "^0.7.219",
    "bitecs": "^0.4.0",
    "box2d-wasm": "^7.0.0",
    "classnames": "^2.5.1",
    "extra-defer": "^0.3.1",
    "extra-ecs": "^0.8.0",
    "extra-game-loop": "^0.3.9",
    "extra-key-state": "^0.2.0",
    "extra-rand": "^0.5.1",
    "extra-react-hooks": "^0.8.13",
    "extra-utils": "^6.2.0",
    "iterable-operator": "^6.0.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "screenfull": "^6.0.2",
    "structure-of-arrays": "^0.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "4",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "rimraf": "^6.1.3",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3",
    "yarn-deduplicate": "^6.0.1"
  }
}
